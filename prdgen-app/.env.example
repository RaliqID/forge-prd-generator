# ─────────────────────────────────────────────
# FORGE — AI PRD Generator
# Copy this file to `.env.local` and fill in the values.
# ─────────────────────────────────────────────

# ── App ──
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ── Database (PostgreSQL 17 — Supabase atau Postgres biasa) ──
# Supabase: Dashboard > Project Settings > Database > Connection string
#   DATABASE_URL  = pooled connection (port 6543, pgbouncer)
#   DIRECT_URL    = direct connection (port 5432)
# Plain Postgres: both point to the same local instance.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/forge"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/forge"

# ── Supabase (Auth) ──
# Get from: Supabase Dashboard > Project Settings > API
# Kosongkan untuk menjalankan lokal tanpa auth (dev-mode); mengisi env ini
# mengaktifkan auth asli + route guard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── AI Providers ──
# Priority: 9Router > AgentRouter > OpenRouter (first configured key wins as fallback)

# 9Router — default/recommended. Local 9Router proxy:
#   http://localhost:20128/v1 (model: Dev-Stack)
# Hosted alternative (optional): https://api.9router.com/v1
NINE_ROUTER_API_KEY=
NINE_ROUTER_BASE_URL=http://localhost:20128/v1

# Model for long-form PRD prose. A combo/router alias is fine here.
NINE_ROUTER_MODEL=Dev-Stack

# Model for STRUCTURED (JSON) phases — the Struktur and Task steps.
# MUST be an explicit instruct model, NOT a combo/router alias. Combo upstreams
# are coding agents that answer a "produce JSON" prompt with a shell tool call
# or prose instead of the object, which yields an empty feature map and a
# client-side retry storm. Verified working: deepseek-v4.1-flash (~6s, valid JSON).
NINE_ROUTER_STRUCTURED_MODEL=deepseek-v4.1-flash

# Model used to WRITE the PRD sections (the 17-section document).
# Defaults to NINE_ROUTER_STRUCTURED_MODEL. Keep it an explicit instruct model:
# measured against a combo alias, a "write exactly these three sections" prompt
# returned a clarifying question and unusable headings, so sections never
# matched and the run had to retry repeatedly (20+ min, never converging).
# The direct model obeys the section list and completes in ~4 min.
NINE_ROUTER_WRITING_MODEL=deepseek-v4.1-flash

# AgentRouter — fixed model: claude-opus-4-8
# Get from: https://agentrouter.org
AGENTROUTER_API_KEY=

# OpenRouter — 1 key untuk semua model (GPT, Claude, Gemini, Kimi, DeepSeek, Qwen)
# Get from: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ── Custom engine security ──
# Encrypts user-supplied engine API keys at rest (AES-256-GCM). REQUIRED for saved AI engines.
# Generate with: openssl rand -base64 48
ENGINE_ENC_SECRET=

# ── Local AI endpoints (self-hosted, single-user) ──
# true = permit localhost/127.0.0.1 engine base URLs for custom engines.
# Required when the AI provider itself runs locally (e.g. self-hosted 9Router).
ALLOW_LOCAL_AI_ENDPOINTS=true

# ── Timeouts (optional; defaults shown) ──
# Whole-request deadline before the stream is aborted.
AI_STREAM_DEADLINE_MS=280000
# No-activity timeout: abort when no chunk arrives for this long.
AI_STREAM_INACTIVITY_MS=200000

# ── Logging ──
# One JSON object per line, with a per-request correlation id.
# debug | info | warn | error
LOG_LEVEL=info
